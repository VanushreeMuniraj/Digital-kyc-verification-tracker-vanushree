        {
          "name": "Receive Verification Created Event",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventType\": \"verification.created\",\n  \"data\": {\n    \"verificationId\": 1,\n    \"customerId\": 2,\n    \"requestedBy\": 3,\n    \"status\": \"PENDING\",\n    \"timestamp\": 1234567890\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/atropos/webhook",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "atropos",
                "webhook"
              ]
            }
          }
        },
        {
          "name": "Receive Verification Status Updated Event",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventType\": \"verification.status.updated\",\n  \"data\": {\n    \"verificationId\": 1,\n    \"oldStatus\": \"PENDING\",\n    \"newStatus\": \"IN_REVIEW\",\n    \"officerId\": 2,\n    \"comments\": \"Starting review\",\n    \"timestamp\": 1234567890\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/atropos/webhook",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "atropos",
                "webhook"
              ]
            }
          }
        },
        {
          "name": "Receive Document Uploaded Event",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventType\": \"document.uploaded\",\n  \"data\": {\n    \"documentId\": 1,\n    \"verificationId\": 1,\n    \"documentType\": \"AADHAAR\",\n    \"fileName\": \"aadhaar.pdf\",\n    \"timestamp\": 1234567890\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/atropos/webhook",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "atropos",
                "webhook"
              ]
            },
            "description": "Response includes viewUrl and downloadUrl. Click the viewUrl to open the document."
          }
        },
